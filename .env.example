# Menu Studio environment.
#
# Copy to .env for local development: `cp .env.example .env`. Every value below is a safe local
# default or a placeholder — no real secret belongs in this file or in git. In staging and
# production these come from AWS Secrets Manager (see infra/lib/secrets-stack.ts); the deployed
# task definitions carry only the non-secret values.
#
# Each service parses its own variables with Zod at startup and refuses to boot on a bad value:
#   packages/server-core/src/config.ts  (shared by api and worker)
#   apps/api/src/config/env.ts          (api only)
#   apps/worker/src/index.ts            (worker only)

# ─── Shared: API and worker ────────────────────────────────────────────────────

# development | test | production. Production additionally refuses the dev secrets below.
NODE_ENV=development

# Postgres. Local default is the embedded server started by `pnpm db:start` (no Docker needed).
# In production this is the Supabase *session* pooler or a direct connection — never the
# transaction pooler on 6543, which pg-boss cannot use.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/menu_studio

# local  = sign in against the local Postgres with a locally signed JWT (development only)
# supabase = verify Supabase access tokens (requires the three SUPABASE_* values)
AUTH_MODE=local

# local = files under DATA_DIR, served through the API's /files route
# supabase = private Supabase Storage buckets (uploads, exports, assets) with signed URLs
STORAGE_MODE=local

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose this to apps/web, apps/menu or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Signs local-mode session tokens. Must be at least 16 characters; production rejects the default.
LOCAL_JWT_SECRET=dev-only-secret-change-me-0123456789
# Signs the 5-minute HMAC tokens that let the worker open the print route, and local signed URLs.
PRINT_TOKEN_SECRET=dev-only-secret-change-me-0123456789

# Public origins. Used for CORS, invite links, QR targets and the print route the worker opens.
WEB_URL=http://127.0.0.1:5223
MENU_URL=http://127.0.0.1:5224
API_URL=http://127.0.0.1:5323

# Where local storage, published menus and the embedded Postgres data directory live.
DATA_DIR=.data

# local = write published QR menus under DATA_DIR/published (served by apps/menu/server.ts)
# s3    = write them to S3_MENU_BUCKET and (optionally) invalidate CloudFront
PUBLISH_TARGET=local
S3_MENU_BUCKET=
CLOUDFRONT_MENU_DISTRIBUTION_ID=
AWS_REGION=eu-west-2

# ─── API ───────────────────────────────────────────────────────────────────────

PORT=5323

# Anthropic key for /extract, /concepts, /edit, /translate, /engineering/suggest and
# /describe-reference. Without it those routes return 503 and the rest of the app still works.
ANTHROPIC_API_KEY=

# Overrides the model id. Leave unset: the default lives in apps/api/src/config/ai.ts, which is
# the only place in the repo a model id may appear.
# AI_MODEL=

# Billing. Stripe everywhere except India, Razorpay for India. Webhooks are rejected unless the
# matching secret is set, so leaving these empty disables billing rather than weakening it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Extra comma-separated CORS origins. WEB_URL is always allowed.
CORS_ORIGINS=

SENTRY_DSN_API=

# ─── Worker ────────────────────────────────────────────────────────────────────

# How many exports one worker process renders at a time. Each one holds a Chromium context.
EXPORT_CONCURRENCY=2
# Loopback-only /health endpoint, used by the ECS container health check and the e2e harness.
WORKER_HEALTH_PORT=5324
SENTRY_DSN_WORKER=

# ─── Owner app (apps/web, build time) ──────────────────────────────────────────

# Vite inlines these into the client bundle, so they must never hold a secret.
VITE_API_URL=http://127.0.0.1:5323
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development

# ─── QR menu site (apps/menu/server.ts, local only) ────────────────────────────

# Directory of published menus served in development. Defaults to DATA_DIR/published.
# PUBLISHED_DIR=

# ─── Scripts and tooling ───────────────────────────────────────────────────────

# Port for the embedded Postgres started by `pnpm db:start`.
LOCAL_DB_PORT=54329
# Owner account created by `pnpm db:seed`. Local auth is passwordless: the dev sign-in page
# takes the email address on its own.
SEED_EMAIL=demo@menu-studio.local
# debug | info | warn | error
LOG_LEVEL=info
