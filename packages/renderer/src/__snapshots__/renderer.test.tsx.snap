ont-weight="700" font-family="inherit" fill="currentColor">GF</text></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">₹140</span></span></div></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_fb000008"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Kashmiri Kahwa</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Contains nuts" class="ms-mark ms-mark--contains_nuts"><title>Contains nuts</title><g transform="translate(0 0)"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><text x="12" y="12" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="700" font-family="inherit" fill="currentColor">N</text></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">₹160</span></span></div><p class="ms-item__desc"><span>Green tea with saffron, cinnamon and slivered almonds.</span></p></div></div></div></div></li><li class="ms-journey__step"><div class="ms-journey__marker" aria-hidden="true"><span>3</span></div><div class="ms-journey__body"><h2 class="ms-section__title">All-Day Breakfast</h2><div class="ms-items"><div class="ms-item ms-item--compact" data-ms-item="itm_fb000009"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Akki Roti</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-ma