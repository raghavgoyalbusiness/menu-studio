exports[`renderer snapshots > chalkboard × cocktail-bar-london 1`] = `"<div class="ms-root ms-mode-print ms-arch-chalkboard ms-format-CHALKBOARD_WIDE ms-case-as_written ms-density-balanced ms-price-right_aligned ms-light" style="--ms-bg:#F4EFE6;--ms-surface:#EBE4D8;--ms-text:#1E1B18;--ms-muted:#5E564D;--ms-accent:#A83626;--ms-accent2:#2F4A3A;--ms-accent-text:#A83626;--ms-font-display:&quot;Fraunces&quot;, Georgia, &#x27;Times New Roman&#x27;, serif;--ms-font-body:&quot;Instrument Sans&quot;, system-ui, -apple-system, &#x27;Segoe UI&#x27;, sans-serif;--ms-display-weight:500;--ms-display-scale:1;--ms-display-tracking:0em;--ms-display-case:none;--ms-body-size:9.75pt;--ms-line:1.38;--ms-gap-item:2.8mm;--ms-gap-section:6.5mm;--ms-texture:url(&quot;data:image/svg+xml;utf8,%3Csvg%20xmlns%3D&#x27;http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg&#x27;%20width%3D&#x27;220&#x27;%20height%3D&#x27;220&#x27;%3E%3Cfilter%20id%3D&#x27;n&#x27;%3E%3CfeTurbulence%20type%3D&#x27;fractalNoise&#x27;%20baseFrequency%3D&#x27;0.6&#x27;%20numOctaves%3D&#x27;4&#x27;%20stitchTiles%3D&#x27;stitch&#x27;%2F%3E%3CfeColorMatrix%20values%3D&#x27;0%200%200%200%200%200%200%200%200%200%200%200%200%200%200%200%200%200%200.12%200&#x27;%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D&#x27;100%25&#x27;%20height%3D&#x27;100%25&#x27;%20filter%3D&#x27;url(%2523n)&#x27;%2F%3E%3C%2Fsvg%3E&quot;), radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.06), transparent 60%)" lang="en" dir="ltr" data-ms-root="true"><style>@page { size: 600mm 337.5mm; margin: 0; }</style><div class="ms-pages"><section class="ms-page" data-ms-page="pg_sn000001" data-ms-page-index="0" style="width:600mm;height:337.5mm"><div class="ms-page__bg" style="left:0mm;top:0mm;width:600mm;height:337.5mm"></div><div class="ms-page__trim" style="left:0mm;top:0mm;width:600mm;height:337.5mm"><div class="ms-page__content" data-ms-content="true" style="left:9mm;right:9mm;top:9mm;height:319.5mm"><div class="ms-block ms-block--header ms-emphasis--high" data-ms-block="blk_sn000001"><header class="ms-header"><h1 class="ms-venue"><span>Yoru Niwa</span></h1><div class="ms-divider ms-divider--hairline ms-header__rule" role="separator"></div></header></div><div class="ms-band" style="--ms-cols:3"><div class="ms-column" data-ms-column="0"><div class="ms-block ms-block--section ms-emphasis--normal" data-ms-block="blk_sn000002"><section class="ms-section ms-section--row"><div class="ms-section__heading"><h2 class="ms-section__title"><span>Signatures</span></h2><p class="ms-section__subtitle">Twelve drinks from the night garden</p></div><div class="ms-items"><div class="ms-item ms-item--row ms-item--featured" data-ms-item="itm_ya000001"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Genko</span><span class="ms-badge">Signature</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£16</span></span></div><p class="ms-item__desc"><span>Japanese whisky stirred with hojicha vermouth, bitter orange and cacao.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000002"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Yuzu Highball</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£13</span></span></div><p class="ms-item__desc"><span>Japanese whisky, fresh yuzu and hard-carbonated soda.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000003"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Shiso Gimlet</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£14</span></span></div><p class="ms-item__desc"><span>London dry gin, shiso leaf cordial and lime.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000004"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Umeshu Sour</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£14</span></span></div><p class="ms-item__desc"><span>Plum wine, rice shochu, lemon and a silky egg-white foam.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000005"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Sakura Spritz</span><span class="ms-badge">New</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£13</span></span></div><p class="ms-item__desc"><span>Junmai sake, cherry blossom cordial, sparkling wine and soda.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000006"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Kuro Negroni</span><span class="ms-badge">Signature</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£15</span></span></div><p class="ms-item__desc"><span>Gin, black sesame Campari and sweet vermouth, stirred over a clear block.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000007"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Matcha Colada</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£14</span></span></div><p class="ms-item__desc"><span>White rum, ceremonial matcha, coconut and pineapple.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000008"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Sencha Martini</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£15</span></span></div><p class="ms-item__desc"><span>Vodka and sencha-infused dry vermouth, very cold.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000009"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Kinmokusei Fizz</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£13</span></span></div><p class="ms-item__desc"><span>Gin, osmanthus blossom, lemon and soda.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000010"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Ginger Mule</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£13</span></span></div><p class="ms-item__desc"><span>Barley shochu, fresh ginger, lime and ginger beer.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000011"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Hojicha Espresso Martini</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£15</span></span></div><p class="ms-item__desc"><span>Vodka, roasted hojicha, coffee liqueur and cold brew.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000012"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Plum Blossom Royale</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£16</span></span></div><p class="ms-item__desc"><span>Umeshu topped with sparkling sake.</span></p></div></div></div></section></div></div><div class="ms-column" data-ms-column="1"><div class="ms-block ms-block--section ms-emphasis--normal" data-ms-block="blk_sn000003"><section class="ms-section ms-section--row"><div class="ms-section__heading"><h2 class="ms-section__title"><span>Zero Proof</span></h2></div><div class="ms-items"><div class="ms-item ms-item--row" data-ms-item="itm_ya000013"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Yuzu Tonic</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£8</span></span></div><p class="ms-item__desc"><span>Yuzu, sansho pepper and Indian tonic.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000014"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Hojicha Cold Brew Soda</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£8</span></span></div><p class="ms-item__desc"><span>Roasted green tea cold brew, demerara and soda.</span></p></div></div></div></section></div></div><div class="ms-column" data-ms-column="2"><div class="ms-block ms-block--section ms-emphasis--normal" data-ms-block="blk_sn000004"><section class="ms-section ms-section--row"><div class="ms-section__heading"><h2 class="ms-section__title"><span>Small Plates</span></h2><p class="ms-section__availability">Tue–Sun · 18:00–23:00</p></div><div class="ms-items"><div class="ms-item ms-item--row" data-ms-item="itm_ya000015"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Edamame</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Gluten free" class="ms-mark ms-mark--gluten_free"><title>Gluten free</title><g transform="translate(0 0)"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><text x="12" y="12" text-anchor="middle" dominant-baseline="central" font-size="9" font-weight="700" font-family="inherit" fill="currentColor">GF</text></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£6</span></span></div><p class="ms-item__desc"><span>Sea salt and yuzu kosho.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000016"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Chicken Karaage</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£9</span></span></div><p class="ms-item__desc"><span>Soy and ginger marinated thigh, kewpie and lemon.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000017"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Tuna Tataki</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Mildly spicy" class="ms-mark ms-mark--spicy_1"><title>Mildly spicy</title><g transform="translate(0 0)"><path d="M14.5 5.5 C17 6.7 18 9 17.4 12 C16.3 17 11 20.5 5 20 C8 18.4 11 15.2 12 11 C12.6 8.3 13 6.2 14.5 5.5 Z M14.5 5.5 C14.5 4 15.5 3 17 3" fill="#A3261C" stroke="none"></path></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£12</span></span></div><p class="ms-item__desc"><span>Seared yellowfin, ponzu, spring onion and toasted sesame.</span></p></div></div><div class="ms-item ms-item--row" data-ms-item="itm_ya000018"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Miso Aubergine</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£8</span></span></div><p class="ms-item__desc"><span>Glazed with white miso and finished with sesame.</span></p></div></div></div></section></div></div></div><div class="ms-block ms-block--legend ms-emphasis--normal" data-ms-block="blk_sn000005"><div class="ms-legend"><span class="ms-legend__entry"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg><span>Vegan</span></span><span class="ms-legend__entry"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Gluten free" class="ms-mark ms-mark--gluten_free"><title>Gluten free</title><g transform="translate(0 0)"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><text x="12" y="12" text-anchor="middle" dominant-baseline="central" font-size="9" font-weight="700" font-family="inherit" fill="currentColor">GF</text></g></svg