exports[`renderer snapshots > tasting_journey × bistro-paris 1`] = `"<div class="ms-root ms-mode-print ms-arch-tasting_journey ms-format-A4 ms-case-as_written ms-density-balanced ms-price-right_aligned ms-light" style="--ms-bg:#F4EFE6;--ms-surface:#EBE4D8;--ms-text:#1E1B18;--ms-muted:#5E564D;--ms-accent:#A83626;--ms-accent2:#2F4A3A;--ms-accent-text:#A83626;--ms-font-display:&quot;Fraunces&quot;, Georgia, &#x27;Times New Roman&#x27;, serif;--ms-font-body:&quot;Instrument Sans&quot;, system-ui, -apple-system, &#x27;Segoe UI&#x27;, sans-serif;--ms-display-weight:500;--ms-display-scale:1;--ms-display-tracking:0em;--ms-display-case:none;--ms-body-size:9.75pt;--ms-line:1.38;--ms-gap-item:2.8mm;--ms-gap-section:6.5mm" lang="en" dir="ltr" data-ms-root="true"><style>@page { size: 216mm 303mm; margin: 0; }</style><div class="ms-pages"><section class="ms-page" data-ms-page="pg_sn000001" data-ms-page-index="0" style="width:216mm;height:303mm"><div class="ms-page__bg" style="left:0mm;top:0mm;width:216mm;height:303mm"></div><div class="ms-page__trim" style="left:3mm;top:3mm;width:210mm;height:297mm"><div class="ms-page__content" data-ms-content="true" style="left:9mm;right:9mm;top:9mm;height:279mm"><div class="ms-block ms-block--header ms-emphasis--high" data-ms-block="blk_sn000001"><header class="ms-header"><h1 class="ms-venue"><span>Chez Lucette</span></h1><div class="ms-divider ms-divider--hairline ms-header__rule" role="separator"></div></header></div><ol class="ms-journey ms-journey--vertical" data-ms-block="journey"><li class="ms-journey__step"><div class="ms-journey__marker" aria-hidden="true"><span>1</span></div><div class="ms-journey__body"><h2 class="ms-section__title">Menu du Jour</h2><div class="ms-items"><div class="ms-item ms-item--compact ms-item--featured" data-ms-item="itm_cl000001"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Prix Fixe</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price ms-price--variants "><span class="ms-price__variant"><span class="ms-price__label">Deux plats</span><span class="ms-price__amount">£24</span></span><span class="ms-price__variant"><span class="ms-price__label">Trois plats</span><span class="ms-price__amount">£29</span></span></span></div><p class="ms-item__desc"><span>Soupe à l&#x27;oignon or pâté de campagne; steak haché or ratatouille; crème caramel.</span></p></div></div></div></div></li><li class="ms-journey__step"><div class="ms-journey__marker" aria-hidden="true"><span>2</span></div><div class="ms-journey__body"><h2 class="ms-section__title">Entrées</h2><div class="ms-items"><div class="ms-item ms-item--compact" data-ms-item="itm_cl000002"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Soupe à l&#x27;Oignon Gratinée</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£9</span></span></div><p class="ms-item__desc"><span>Slow-cooked onions, beef stock, Comté crouton.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000003"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Escargots de Bourgogne</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£12</span></span></div><p class="ms-item__desc"><span>Six snails in parsley and garlic butter.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000004"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Salade Lyonnaise</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£11</span></span></div><p class="ms-item__desc"><span>Frisée, lardons, croutons and a soft poached egg.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000005"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Pâté de Campagne</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£10</span></span></div><p class="ms-item__desc"><span>Cornichons, Dijon mustard and toasted sourdough.</span></p></div></div></div></div></li><li class="ms-journey__step"><div class="ms-journey__marker" aria-hidden="true"><span>3</span></div><div class="ms-journey__body"><h2 class="ms-section__title">Plats</h2><div class="ms-items"><div class="ms-item ms-item--compact" data-ms-item="itm_cl000006"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Steak Frites</span><span class="ms-badge">Signature</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£26</span></span></div><p class="ms-item__desc"><span>Bavette, sauce béarnaise and hand-cut frites.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000007"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Moules Marinières</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£21</span></span></div><p class="ms-item__desc"><span>Cornish mussels, white wine, shallots and cream.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000008"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Confit de Canard</span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">£24</span></span></div><p class="ms-item__desc"><span>Duck leg, pommes sarladaises and frisée.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_cl000009"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Ratatouille Provençale</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--veg