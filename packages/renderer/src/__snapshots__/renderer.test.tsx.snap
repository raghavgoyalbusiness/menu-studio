12" r="5.5" fill="#1B7F3B"></circle></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">₹210</span></span></div><p class="ms-item__desc"><span>Double ristretto from Chikmagalur estates.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_fb000004"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Cold Brew</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegan" class="ms-mark ms-mark--vegan"><title>Vegan</title><g transform="translate(0 0)"><path d="M4 20 C4 10 10 4 20 4 C20 13 14.5 20 4 20 Z M4 20 L14 10" fill="none" stroke="#1B7F3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price ms-price--variants "><span class="ms-price__variant"><span class="ms-price__label">Regular</span><span class="ms-price__amount">₹190</span></span><span class="ms-price__variant"><span class="ms-price__label">Large</span><span class="ms-price__amount">₹240</span></span></span></div><p class="ms-item__desc"><span>Steeped for eighteen hours.</span></p></div></div><div class="ms-item ms-item--compact" data-ms-item="itm_fb000005"><div class="ms-item__body"><div class="ms-item__head"><span class="ms-item__name">Vietnamese Iced Coffee</span><span class="ms-badge">New</span><span class="ms-marks"><svg viewBox="0 0 24 24" height="0.95em" width="calc(0.95em * 1)" role="img" aria-label="Vegetarian" class="ms-mark ms-mark--veg"><title>Vegetarian</title><g transform="translate(0 0)"><rect x="1.5" y="1.5" width="21" height="21" rx="2" fill="none" stroke="#1B7F3B" stroke-width="2"></rect><circle cx="12" cy="12" r="5.5" fill="#1B7F3B"></circle></g></svg></span><span class="ms-spacer" aria-hidden="true"></span><span class="ms-price "><span class="ms-price__amount">₹230</span></span></div><p class="ms